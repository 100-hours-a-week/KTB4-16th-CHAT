  "spam_regex": [
    {
      "name": "전화번호",
      "pattern": "01[016789][\\s.-]?\\d{3,4}[\\s.-]?\\d{4}"
    },
    {
      "name": "전화번호_한글",
      "pattern": "공[\\s\\d.-]*일[\\s\\d.-]*공"
    },
    {
      "name": "링크",
      "pattern": "(https?://|www\\.)\\S+"
    },
    {
      "name": "단축링크",
      "pattern": "(bit|han|me2)\\s*\\.\\s*(ly|gl|do)"
    },
    {
      "name": "오픈채팅",
      "pattern": "(오픈\\s*채팅|오픈\\s*톡|ㅇㅍㅊ|open\\.kakao)"
    },
    {
      "name": "메신저_아이디",
      "pattern": "(텔레(그램)?|카톡|라인)\\s*(아이디|id|@)"
    },
    {
      "name": "계좌",
      "pattern": "\\d{2,6}-\\d{2,6}-\\d{2,8}"
    },
    {
      "name": "홍보",
      "pattern": "(팔로워|구독자|좋아요)\\s*(늘려|올려)"
    },
    {
      "name": "입금_유도",
      "pattern": "입금\\s*(하면|해주면|시)"
    }
  ]
